# The launcher's Windows cross-build: Ubuntu 24.04's mingw-w64 (GCC 13,
# posix threads, so std::thread works), CMake and Ninja. No MSVC, no Windows
# machine: everything the artifact needs — SDL2, a static libcurl on the
# operating system's own TLS (Schannel), libxlive, the launcher — is built
# here from source by tools/release_windows.sh.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl xz-utils zstd file zip \
        cmake ninja-build make pkg-config python3 \
        g++-mingw-w64-x86-64-posix gcc-mingw-w64-x86-64-posix binutils-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --set x86_64-w64-mingw32-g++ /usr/bin/x86_64-w64-mingw32-g++-posix \
    && update-alternatives --set x86_64-w64-mingw32-gcc /usr/bin/x86_64-w64-mingw32-gcc-posix
